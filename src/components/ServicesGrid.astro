---
const services = [
  {
    title: 'Automotive Electric',
    description: 'Alternator and starter rebuilding exceeding OEM standards, magneto rebuilding, battery testing, wiring repairs, remote starters, backup cameras, Bluetooth, stereo, and complete electrical diagnostics.',
    href: '/services/automotive-electric',
    image: '/images/services/automotive-electric.webp',
    alt: 'Technician testing a vehicle battery and charging system with a multimeter and diagnostic tablet',
  },
  {
    title: 'Automotive Repair',
    description: 'Complete auto repair for any make or model. Computer diagnostics, brake service, tune-ups, oil changes, shocks/struts, fuel injection, AC repair, PA state inspections, and motorcycle inspections.',
    href: '/services/automotive-repair',
    image: '/images/services/automotive-repair.webp',
    alt: 'Technician using diagnostic equipment beside a vehicle in the repair shop',
  },
  {
    title: 'Farming & Industrial',
    description: 'Heavy equipment electrical and mechanical repair. John Deere flat face fittings supplier. Hydraulic hose repair and custom manufacturing, voltage conversions, high-output alternators.',
    href: '/services/farming-industrial',
    image: '/images/services/farming-industrial.webp',
    alt: 'Illustration of a technician repairing a farm tractor and hydraulic systems in a workshop',
  },
  {
    title: 'Emergency Vehicle Conversion',
    description: 'Emergency vehicle upfitting and ongoing fleet maintenance. Light bars, sirens, radios, partitions, and more. Trusted by local police, fire, and EMS departments.',
    href: '/services/emergency-vehicle-conversion',
    image: '/images/services/emergency-vehicle-conversion.webp',
    alt: 'Illustration of a technician installing emergency lighting and electrical equipment in a police-style SUV',
  },
  {
    title: 'Transmission & Engine',
    description: 'Complete transmission and engine replacement for foreign and domestic vehicles. Diagnostics, fluid services, filter changes, programming, and expert installation.',
    href: '/services/transmission-engine-replacement',
    image: '/images/services/transmission-engine.webp',
    alt: 'Vehicle engine and front assembly removed during major repair work',
  },
  {
    title: 'Intoxalock',
    description: 'Certified Intoxalock installer. Installation, calibration, lockout service, maintenance, and removal.',
    href: '/services/intoxalock',
    image: '/images/services/intoxalock.webp',
    alt: 'Technician installing and testing an ignition interlock device beneath a vehicle dashboard',
  },
];
---

<section id="services" class="py-20 bg-kd-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <span class="text-kd-red font-semibold text-sm uppercase tracking-wider">Our Services</span>
      <h2 class="text-3xl sm:text-4xl font-black text-kd-black mt-2">Quality STARTS Here</h2>
      <p class="text-kd-gray-500 mt-3 max-w-2xl mx-auto">
        From electrical diagnostics to complete engine replacements, our experienced team handles it all.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((service) => (
        <a
          href={service.href}
          class="group bg-kd-white rounded-xl overflow-hidden shadow-sm border border-kd-gray-200 hover:shadow-lg hover:border-kd-red/30 hover:-translate-y-0.5 transition-all duration-200"
        >
          <div class="h-44 bg-kd-gray-100 overflow-hidden">
            <img
              src={service.image}
              alt={service.alt}
              width="1200"
              height="675"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          <div class="p-5">
            <h3 class="font-bold text-lg text-kd-black mb-2 group-hover:text-kd-red transition-colors">{service.title}</h3>
            <p class="text-sm text-kd-gray-500 leading-relaxed">{service.description}</p>
            <span class="inline-flex items-center gap-1 text-kd-red text-sm font-semibold mt-3 group-hover:gap-2 transition-all">
              Learn More
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
