---
const { review, large = false, topAccent = false } = Astro.props;
---
<article
  class={
    topAccent
      ? 'bg-kd-gray-900 rounded-xl border border-kd-gray-800 border-t-4 border-t-kd-red p-6 sm:p-8'
      : 'bg-kd-gray-900 rounded-xl border border-kd-gray-800 p-6'
  }
>
  <div class="flex items-start justify-between gap-4">
    <div class="flex items-center gap-3">
      <div
        class={
          large
            ? 'w-11 h-11 rounded-full bg-kd-red text-kd-white flex items-center justify-center font-bold text-sm shrink-0'
            : 'w-9 h-9 rounded-full bg-kd-red text-kd-white flex items-center justify-center font-bold text-xs shrink-0'
        }
        aria-hidden="true"
      >{review.initials}</div>
      <div>
        <h3 class="font-bold text-kd-white">{review.author}</h3>
        <p class="flex items-center gap-1.5 text-xs text-kd-gray-400">
          <span class="w-1.5 h-1.5 rounded-full bg-kd-red inline-block shrink-0" aria-hidden="true" />
          Google Review
        </p>
      </div>
    </div>
    <div class="flex gap-1" aria-label={`${review.rating} star rating`}>
      {Array.from({ length: review.rating }).map(() => (
        <svg class="w-4 h-4 text-kd-yellow" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
        </svg>
      ))}
    </div>
  </div>
  {
    review.quote && (
      <blockquote class="mt-6 text-xl sm:text-2xl font-bold text-kd-white leading-snug">
        &ldquo;{review.quote}&rdquo;
      </blockquote>
    )
  }
  <p class="mt-4 text-sm text-kd-gray-300 leading-relaxed">&ldquo;{review.text}&rdquo;</p>
</article>
