---
// Customer feedback section — static, AI-assisted summary of the genuine
// Google reviews collected for K&D. Rendered entirely from site content; no
// API calls. Owner-approved wording, do not rewrite.
import { googleReviewLinks } from '../data/google-review-links';

const themes = [
  'Honest communication',
  'Difficult problems diagnosed',
  'Fast help when it matters',
  'Fair pricing and no overcharging',
];
---
<section id="google-review-summary" class="bg-kd-black py-16" aria-labelledby="grs-heading">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="border-t-4 border-t-kd-red pt-6 lg:pt-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-x-12 lg:items-start">
        <!-- Left: eyebrow, heading, summary, disclosure -->
        <div>
          <p id="grs-eyebrow" class="text-kd-yellow font-semibold text-sm uppercase tracking-wider">AI CUSTOMER REVIEW SUMMARY</p>
          <h2 id="grs-heading" class="mt-3 text-3xl sm:text-4xl font-black text-kd-white leading-tight">What customers consistently say about K&amp;D</h2>
          <p class="mt-4 text-kd-gray-400 leading-relaxed">Customers describe K&amp;D Auto Electric as honest, responsive, and willing to go beyond a routine repair. Reviews frequently mention clear communication, fair pricing, fast help during stressful breakdowns, and the ability to diagnose electrical and mechanical problems that others could not solve. Customers also appreciate the team&rsquo;s personal attention, concern for safety, and willingness to help on short notice.</p>
          <p class="mt-5 text-xs text-kd-gray-500 leading-relaxed">AI-assisted summary of customer reviews published on Google. Last updated August 2026.</p>
        </div>
        <!-- Right: theme highlights + Google buttons -->
        <div class="mt-8 lg:mt-0">
          <ul class="space-y-2.5">
            {
              themes.map((theme) => (
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 h-2 w-2 shrink-0 rounded-sm bg-kd-red" aria-hidden="true"></span>
                  <span class="text-kd-gray-300">{theme}</span>
                </li>
              ))
            }
          </ul>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={googleReviewLinks.readReviewsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-6 py-3 bg-kd-red hover:bg-kd-red-dark text-kd-white font-semibold rounded-lg transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-kd-yellow">Read Current Reviews on Google</a>
            <a href={googleReviewLinks.writeReviewUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-6 py-3 border border-kd-gray-600 text-kd-white font-semibold rounded-lg hover:border-kd-gray-400 hover:text-kd-yellow transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-kd-yellow">Write a Google Review</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
